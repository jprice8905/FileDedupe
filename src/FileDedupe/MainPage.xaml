<Page
    x:Class="FileDedupe.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FileDedupe.ViewModels">

    <Grid x:Name="RootGrid" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Actions -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Add Directory"
                    Command="{x:Bind ViewModel.AddDirectoryCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotConverter}}" />
            <Button Content="Add Archive Directory"
                    Command="{x:Bind ViewModel.AddArchiveDirectoryCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotConverter}}" />
            <Button Content="Scan"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotConverter}}" />
            <Button Content="Get Duplicates"
                    Command="{x:Bind ViewModel.GetDuplicatesCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotConverter}}" />
            <Button Content="Update File Records"
                    Command="{x:Bind ViewModel.UpdateFileRecordsCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource NotConverter}}" />
            <CheckBox Content="Preview mode"
                      VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.PreviewMode, Mode=TwoWay}" />
        </StackPanel>

        <!-- Archive target and settings -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock>
                <Run Text="Archive root:" FontWeight="SemiBold" />
                <Run Text="{x:Bind ViewModel.ArchiveDirectory, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                <Run Text="Minimum file size:" />
                <Run Text="{x:Bind ViewModel.MinimumFileSizeText}" />
                <Run Text=" | Archive mode:" />
                <Run Text="{x:Bind ViewModel.ArchiveModeText}" />
                <Run Text=" | Hidden and system items are skipped." />
            </TextBlock>
        </StackPanel>

        <!-- Scan order -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Directories to scan (first is primary, scanned in order added)"
                           FontWeight="SemiBold" />

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Directories, Mode=OneWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScanDirectory">
                            <Grid ColumnSpacing="8" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Display}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Click="OnRemoveDirectoryClick" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Results -->
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock FontWeight="SemiBold">
                <Run Text="Duplicates found:" />
                <Run Text="{x:Bind ViewModel.DuplicateCount, Mode=OneWay}" />
                <Run Text=" | Total size:" />
                <Run Text="{x:Bind ViewModel.DuplicateSizeText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="4" Spacing="6">
            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="2" />
        </StackPanel>
    </Grid>
</Page>
